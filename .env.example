# Project Volusia — Environment Variables
# Copy to .env and fill in your API keys
# NEVER commit .env files — they are gitignored

# US Census Bureau API Key (free at https://api.census.gov/data/key_signup.html)
CENSUS_API_KEY=

# BLS API Key (free at https://data.bls.gov/registrationEngine/)
BLS_API_KEY=

# BEA API Key (free at https://apps.bea.gov/api/signup/)
BEA_API_KEY=

# Refresh token for /refresh endpoint (any string, used for HMAC auth)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
VOLUSIA_REFRESH_TOKEN=

# Rate limit: requests per minute per IP (0 = disabled)
VOLUSIA_RATE_LIMIT=60
